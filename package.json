{
  "name": "ai-revolution-screener",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "backfill": "tsx --env-file=.env.local scripts/backfill.ts",
    "verify:screen": "tsx --env-file=.env.local scripts/verify-screen.ts",
    "book:snapshot": "tsx --env-file=.env.local scripts/book-snapshot.ts",
    "audit:data": "tsx --env-file-if-exists=.env.local scripts/audit.ts",
    "audit": "npm run typecheck && npm run test && npm run audit:data",
    "refetch-splits": "tsx --env-file=.env.local scripts/refetch-splits.ts",
    "splits": "tsx --env-file=.env.local scripts/splits.ts",
    "health": "tsx --env-file=.env.local scripts/health.ts",
    "sectors": "tsx --env-file=.env.local scripts/sectors.ts",
    "backtest": "tsx --env-file=.env.local scripts/backtest.ts",
    "replay": "tsx --env-file=.env.local scripts/replay-tiers.ts",
    "digest:preview": "tsx --env-file=.env.local scripts/preview-digest.ts",
    "mail-ledger": "tsx --env-file=.env.local scripts/mail-ledger.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "jose": "^6.2.9",
    "next": "16.3.1",
    "nodemailer": "^9.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
